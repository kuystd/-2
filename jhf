-- Helper Functions
--========================

local function applyWalkSpeed(humanoid)
    if humanoid then
        humanoid.WalkSpeed = walkSpeed
    end
end

-- ฟังก์ชันกระโดด/เดินเบี่ยงเพื่อหลบสิ่งกีดขวางเมื่อติด
local function unstuckAction(humanoid, root)
    if not humanoid or not root then return end
    
    humanoid.Jump = true
    
    -- สุ่มทิศทางหลบ (ซ้าย ขวา หรือ ถอยหลัง)
    local directions = {
        -root.CFrame.RightVector,
        root.CFrame.RightVector,
        -root.CFrame.LookVector
    }
    local randomDir = directions[math.random(1, #directions)]
    
    humanoid:Move(randomDir, false)
    task.wait(0.6)
    humanoid:Move(Vector3.new(0, 0, 0), false)
end

-- ฟังก์ชันเดินไปยังตำแหน่งเป้าหมายพร้อมระบบหลบสิ่งกีดขวาง
local function walkTo(position)
    local character = player.Character or player.CharacterAdded:Wait()
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local root = character:FindFirstChild("HumanoidRootPart")

    if not humanoid or not root then return false end

    applyWalkSpeed(humanoid)

    local path = PathfindingService:CreatePath({
        AgentRadius = 2.5,
        AgentHeight = 5,
        AgentCanJump = true,
        AgentMaxSlope = 50
    })

    local success, err = pcall(function()
        path:ComputeAsync(root.Position, position)
    end)

    if not success or path.Status ~= Enum.PathStatus.Success then
        -- หาก Pathfinding สร้างเส้นทางไม่ได้ ลองกระโดดเบี่ยงตัวแล้วลองใหม่
        unstuckAction(humanoid, root)
        return false
    end

    local waypoints = path:GetWaypoints()

    for i, waypoint in ipairs(waypoints) do
        if not running then return false end

        applyWalkSpeed(humanoid)

        if waypoint.Action == Enum.PathWaypointAction.Jump then
            humanoid.Jump = true
        end

        humanoid:MoveTo(waypoint.Position)

        -- ตรวจจับการติดสิ่งกีดขวางระหว่างเดินไป Waypoint
        local startTime = tick()
        local lastPos = root.Position
        local reached = false

        while running and (tick() - startTime < 6) do
            local distance = (root.Position - waypoint.Position).Magnitude
            if distance <= 3 then
                reached = true
                break
            end

            -- ตรวจสอบว่าตัวละครติดสิ่งกีดขวางหรือไม่ (ตำแหน่งไม่เปลี่ยนเกิน 2.5 วินาที)
            if (tick() - startTime > 2.5) and (root.Position - lastPos).Magnitude < 0.8 then
                -- ตัวละครติดสิ่งกีดขวาง -> กระโดดเบี่ยงหลบแล้ว Re-pathing ใหม่
                unstuckAction(humanoid, root)
                return walkTo(position) -- คำนวณเส้นทางใหม่ทันที
            end

            task.wait(0.1)
        end

        if not reached then
            unstuckAction(humanoid, root)
            return false
        end
    end

    humanoid:MoveTo(root.Position)
    return true
end

-- ฟังก์ชันค้นหา ProximityPrompt ในระยะ
local function getNearestPrompt(position)
    local nearest = nil
    local nearestDistance = 12

    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("ProximityPrompt") and obj.Enabled then
            local parent = obj.Parent
            if parent and parent:IsA("BasePart") then
                local distance = (parent.Position - position).Magnitude
                if distance < nearestDistance then
                    nearestDistance = distance
                    nearest = obj
                end
            end
        end
    end

    return nearest
end

-- ฟังก์ชันกด Prompt 1 ครั้ง (สำหรับจุดที่ 1)
local function triggerPromptOnce(position)
    local prompt = getNearestPrompt(position)
    if not prompt then return false end

    task.wait(promptDelay)
    local holdTime = overrideHoldDuration and customHoldTime or (prompt.HoldDuration > 0 and (prompt.HoldDuration + 0.1) or 0.1)

    if fireproximityprompt then
        fireproximityprompt(prompt)
    else
        prompt:InputHoldBegin()
        task.wait(holdTime)
        prompt:InputHoldEnd()
    end

    return true
end

-- ฟังก์ชันกด Prompt ซ้ำเรื่อยๆ จนกว่าปุ่มจะหายไป (สำหรับจุดที่ 2 เป็นต้นไป)
local function triggerPromptRepeatedly(position, statusCallback)
    local prompt = getNearestPrompt(position)

    if not prompt then
        return false
    end

    local pressCount = 0

    while running and prompt and prompt.Parent and prompt.Enabled do
        pressCount = pressCount + 1
        if statusCallback then
            statusCallback("กำลังกดครั้งที่ " .. pressCount)
        end

        task.wait(promptDelay)

        local holdTime = overrideHoldDuration and customHoldTime or (prompt.HoldDuration > 0 and (prompt.HoldDuration + 0.1) or 0.1)

        if fireproximityprompt then
            fireproximityprompt(prompt)
        else
            prompt:InputHoldBegin()
            task.wait(holdTime)
            prompt:InputHoldEnd()
        end

        task.wait(0.2)
        prompt = getNearestPrompt(position)
    end

    return true
end

