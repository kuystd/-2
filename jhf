MainTab:CreateButton({
    Name = "▶ เริ่มทำงาน (START)",
    Callback = function()
        if running then
            Rayfield:Notify({Title = "แจ้งเตือน", Content = "ระบบกำลังทำงานอยู่แล้ว!", Duration = 3})
            return
        end

        if #points < 2 then
            Rayfield:Notify({Title = "แจ้งเตือน", Content = "กรุณาเพิ่มอย่างน้อย 2 จุด! (จุดที่ 1 = รับไม้, จุดที่ 2 = วางไม้)", Duration = 3})
            return
        end

        running = true
        task.spawn(function()
            local loopCount = 1

            while running do
                local currentIndex = 1

                while currentIndex <= #points and running do
                    local point = points[currentIndex]
                    local loopInfo = string.format(" (รอบที่ %d)", loopCount)

                    if currentIndex == 1 then
                        -- ===================================
                        -- จุดที่ 1: รับไม้ (กด 1 ครั้ง)
                        -- ===================================
                        updateStatus("กำลังเดินไปรับไม้ที่จุด 1 (กด 1 ครั้ง)" .. loopInfo)
                        local success = walkTo(point.position)

                        if success and running then
                            updateStatus("ถึงจุด 1 - กำลังกดรับไม้ 1 ครั้ง...")
                            
                            local triggered = triggerPromptOnce(point.position)

                            if triggered then
                                Rayfield:Notify({
                                    Title = "รับไม้สำเร็จ", 
                                    Content = "กดรับไม้ที่จุด 1 เรียบร้อย (1 ครั้ง)", 
                                    Duration = 1.5
                                })
                            else
                                Rayfield:Notify({
                                    Title = "แจ้งเตือน", 
                                    Content = "ไม่พบปุ่มกดที่จุด 1", 
                                    Duration = 1.5
                                })
                            end

                            task.wait(point.waitTime)
                            currentIndex = 2 -- เดินไปจุดวางไม้จุดที่ 2
                        end
                    else
                        -- ===================================
                        -- จุดที่ 2+: วางไม้ (กดเรื่อยๆ จนกว่าจะหมด)
                        -- ===================================
                        updateStatus("กำลังเดินไปวางไม้ที่จุดที่ " .. currentIndex .. loopInfo)
                        local success = walkTo(point.position)

                        if success and running then
                            updateStatus("ถึงจุด " .. currentIndex .. " - กำลังวางไม้เรื่อยๆ...")

                            local placedWood = triggerPromptRepeatedly(point.position, function(msg)
                                updateStatus("จุดวางไม้ที่ " .. currentIndex .. ": " .. msg)
                            end)

                            if placedWood then
                                Rayfield:Notify({
                                    Title = "วางไม้เสร็จสิ้น", 
                                    Content = "ไม่มีปุ่มวางเหลือที่จุด " .. currentIndex .. " -> กลับไปรับไม้จุด 1", 
                                    Duration = 1.5
                                })
                            else
                                Rayfield:Notify({
                                    Title = "ไม่พบปุ่มวางไม้", 
                                    Content = "ไม่มีปุ่มที่จุด " .. currentIndex .. " -> กลับไปรับไม้จุด 1", 
                                    Duration = 1.5
                                })
                            end

                            task.wait(point.waitTime)
                            currentIndex = 1 -- ไม้หมด/ไม่มีปุ่มให้กดแล้ว กลับไปรับไม้ที่จุด 1 ทันที
                        end
                    end
                end

                if not loopEnabled or not running then
                    break
                end

                loopCount = loopCount + 1
                task.wait(0.5)
            end

            running = false
            updateStatus("ทำงานเสร็จสิ้นเรียบร้อย")
        end)
    end,
})

