--// State
local State = {
    HeadLockEnabled = false,
    ESPEnabled = false,
    TeamCheck = true,
    LockPart = "Head",
    LockPositionMode = "Above Head", -- "Above Head" | "Below Player" | "Center of Target"
    CustomOffset = Vector3.new(0, 3, 0),
    Smoothness = 0.15,
    FOV = 120,
    ShowFOV = true,
    ESPColor = Color3.fromRGB(255, 0, 0),
    ESPTransparency = 0.5
}

