local function updateStatus(msg)
    local loopText = loopEnabled and "เปิด" or "ปิด"
    StatusParagraph:Set({
        Title = "สถานะระบบ",
        Content = string.format("สถานะ: %s | จุดเส้นทาง: %d จุด | วนซ้ำ: %s", msg, #recordedPath, loopText)
    })
end

MainTab:CreateToggle({
