RecordTab:CreateButton({
    Name = "🔴 1. เริ่มอัดเส้นทางเดิน (ยืนที่จุดรับไม้)",
    Callback = function()
        if recording then
            Rayfield:Notify({Title = "แจ้งเตือน", Content = "กำลังอัดเส้นทางอยู่แล้ว!", Duration = 3})
            return
        end

        local char = player.Character
        if not char or not char:FindFirstChild("HumanoidRootPart") then
            Rayfield:Notify({Title = "ข้อผิดพลาด", Content = "ไม่พบตัวละคร", Duration = 3})
            return
        end

        recordedPath = {}
        recording = true
        
        Rayfield:Notify({
            Title = "เริ่มอัดเส้นทางแล้ว!", 
            Content = "กรุณาเดินไปจุดวางไม้ (จุดที่ 2) ได้เลย...", 
            Duration = 4
        })

        -- ลูปอัดตำแหน่งย่อยทุกๆ 0.15 วินาที
        task.spawn(function()
            while recording do
                local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
                if root then
                    local currentPos = root.Position
                    
                    if #recordedPath == 0 or (recordedPath[#recordedPath] - currentPos).Magnitude >= 1.5 then
                        table.insert(recordedPath, currentPos)
                        updateStatus(string.format("กำลังอัดเส้นทาง... (บันทึกแล้ว %d จุด)", #recordedPath))
                    end
                end
                task.wait(0.15)
            end
        end)
    end,
})

