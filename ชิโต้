    CurrentValue = true,
    Flag = "LoopToggle",
    Callback = function(Value)
        loopEnabled = Value
        updateStatus(running and "กำลังทำงาน..." or "พร้อมทำงาน")
    end,
})

MainTab:CreateButton({
    Name = "▶ เริ่มทำงาน (START)",
    Callback = function()
        if running then
            Rayfield:Notify({Title = "แจ้งเตือน", Content = "ระบบกำลังทำงานอยู่แล้ว!", Duration = 3})
            return
        end

        if #recordedPath < 2 then
            Rayfield:Notify({Title = "แจ้งเตือน", Content = "ยังไม่ได้อัดเส้นทางเดิน! กรุณาไปที่แท็บ 'บันทึกเส้นทาง'", Duration = 3})
            return
        end

        running = true
        task.spawn(function()
            local loopCount = 1

            while running do
                local loopInfo = string.format(" (รอบที่ %d)", loopCount)

                -- 1. เช็คจุดที่ 1 (จุดรับไม้)
                updateStatus("ถึงจุดที่ 1 - ตรวจสอบปุ่มรับไม้..." .. loopInfo)
                local startPoint = recordedPath[1]
                local triggeredStart = tryTriggerPromptOnce(startPoint)

                if triggeredStart then
                    Rayfield:Notify({Title = "รับไม้สำเร็จ", Content = "พบปุ่มและกดรับไม้เรียบร้อย", Duration = 1.5})
                    task.wait(pointWaitTimes.point1)
                else
                    Rayfield:Notify({Title = "ข้ามจุดที่ 1", Content = "ไม่พบปุ่มกดที่จุดที่ 1 (เดินไปจุดที่ 2 ต่อทันที)", Duration = 1.5})
                end

                -- 2. เดินตามรอยเดิมไปจุดที่ 2
                for i = 2, #recordedPath do
                    if not running then break end
                    updateStatus(string.format("กำลังเดินตามรอยเดิมไปจุดที่ 2 (%d/%d)...", i, #recordedPath))
                    walkToDirect(recordedPath[i])
                end

                -- 3. เช็คจุดที่ 2 (จุดวางไม้)
                if running then
                    local endPoint = recordedPath[#recordedPath]
                    updateStatus("ถึงจุดที่ 2 - ตรวจสอบปุ่มวางไม้...")
                    
                    local hasPressed = tryTriggerPromptRepeatedly(endPoint, function(msg)
                        updateStatus(msg)
                    end)

                    if hasPressed then
                        Rayfield:Notify({Title = "วางไม้เสร็จสิ้น", Content = "วางไม้เรียบร้อย กำลังเดินกลับจุดที่ 1...", Duration = 1.5})
                    else
                        Rayfield:Notify({Title = "ไม่พบปุ่มวางไม้", Content = "ไม่มีปุ่มให้กดที่จุดที่ 2 เดินกลับจุดที่ 1 ทันที", Duration = 1.5})
                    end

                    task.wait(pointWaitTimes.point2)
                end

                -- 4. เดินย้อนกลับตามรอยเดิมเพื่อไปจุดที่ 1
                for i = #recordedPath - 1, 1, -1 do
                    if not running then break end
                    updateStatus(string.format("กำลังเดินย้อนกลับไปจุดที่ 1 (%d/1)...", i))
                    walkToDirect(recordedPath[i])
                end

                if not loopEnabled or not running then break end
                loopCount = loopCount + 1
                task.wait(0.5)
            end

            running = false
            updateStatus("ทำงานเสร็จสิ้นเรียบร้อย")
        end)
    end,
})

MainTab:CreateButton({
    Name = "■ หยุดทำงาน (STOP)",
    Callback = function()
        running = false
        updateStatus("หยุดการทำงานแล้ว")
    end,
})

