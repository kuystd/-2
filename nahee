            Rayfield:Notify({Title = "ข้อผิดพลาด", Content = "ไม่พบตัวละคร", Duration = 3})
            return
        end

        recordedPath = {}
        recording = true
        
        Rayfield:Notify({
            Title = "เริ่มอัดเส้นทาง!", 
            Content = "เดินไปจุดวางไม้ (จุดที่ 2) ได้เลย...", 
            Duration = 4
        })

        task.spawn(function()
            while recording do
                local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
                if root then
                    local currentPos = root.Position
                    if #recordedPath == 0 or (recordedPath[#recordedPath] - currentPos).Magnitude >= 0.4 then
                        table.insert(recordedPath, currentPos)
                        updateStatus(string.format("กำลังอัดเส้นทาง... (บันทึกแล้ว %d จุด)", #recordedPath))
                    end
                end
                task.wait(0.05)
            end
        end)
    end,
})

