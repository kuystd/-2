--========================
-- Helper Functions
--========================

local function applyWalkSpeed(humanoid)
    if humanoid then
        humanoid.WalkSpeed = walkSpeed
    end
end

-- ฟังก์ชันถือ/ใช้งานไอเทมตามช่องที่เลือก (Slot 1 - 9)
local function equipSlotItem(slotName)
    if slotName == "ไม่ใช้งาน (None)" then return end

    local slotNumber = tonumber(string.match(slotName, "%d+"))
    if not slotNumber then return end

    local character = player.Character or player.CharacterAdded:Wait()
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local backpack = player:FindFirstChild("Backpack")

    if not backpack or not humanoid then return end

    local tools = backpack:GetChildren()
    if #tools >= slotNumber then
        local toolToEquip = tools[slotNumber]
        if toolToEquip and toolToEquip:IsA("Tool") then
            humanoid:EquipTool(toolToEquip)
            task.wait(0.2)
            toolToEquip:Activate()
        end
    end
end

-- เดินไปยังจุดเป้าหมายด้วยความแม่นยำสูง (ไม่ตัดโค้ง/ไม่ติดรั้ว)
local function walkToDirect(targetPos)
    local character = player.Character or player.CharacterAdded:Wait()
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local root = character:FindFirstChild("HumanoidRootPart")

    if not humanoid or not root then return false end

    applyWalkSpeed(humanoid)
    humanoid:MoveTo(targetPos)

    local startTime = tick()
    while running and (tick() - startTime < 1.5) do
        local dist = (Vector3.new(root.Position.X, 0, root.Position.Z) - Vector3.new(targetPos.X, 0, targetPos.Z)).Magnitude
        if dist <= 0.8 then
            return true
        end
        task.wait(0.02)
    end
    return true
end

-- ฟังก์ชันค้นหา ProximityPrompt ใกล้พิกัด
local function getNearestPrompt(position)
    local nearest = nil
    local nearestDistance = 12

    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("ProximityPrompt") and obj.Enabled then
            local parent = obj.Parent
            if parent and parent:IsA("BasePart") then
                local distance = (parent.Position - position).Magnitude
                if distance < nearestDistance then
                    nearestDistance = distance
                    nearest = obj
                end
            end
        end
    end

    return nearest
end

-- ฟังก์ชันกด Prompt จุดที่ 1 (ถ้าไม่มีปุ่มจะไม่กด)
local function tryTriggerPromptOnce(position)
    local prompt = getNearestPrompt(position)
    
    if not prompt then 
        return false 
    end

    task.wait(promptDelay)
    local holdTime = overrideHoldDuration and customHoldTime or (prompt.HoldDuration > 0 and (prompt.HoldDuration + 0.1) or 0.1)

    if fireproximityprompt then
        fireproximityprompt(prompt)
    else
        prompt:InputHoldBegin()
        task.wait(holdTime)
        prompt:InputHoldEnd()
    end

    return true
end

-- ฟังก์ชันกด Prompt จุดที่ 2 (กดซ้ำเรื่อยๆ ถ้าไม่มีปุ่มวนกลับทันที)
local function tryTriggerPromptRepeatedly(position, statusCallback)
    local prompt = getNearestPrompt(position)

    if not prompt then 
        return false 
    end

    local pressCount = 0
    while running and prompt and prompt.Parent and prompt.Enabled do
        pressCount = pressCount + 1
        if statusCallback then 
            statusCallback("กำลังกดวางไม้ครั้งที่ " .. pressCount) 
        end

        task.wait(promptDelay)
        local holdTime = overrideHoldDuration and customHoldTime or (prompt.HoldDuration > 0 and (prompt.HoldDuration + 0.1) or 0.1)

        if fireproximityprompt then
            fireproximityprompt(prompt)
        else
            prompt:InputHoldBegin()
            task.wait(holdTime)
            prompt:InputHoldEnd()
        end

        task.wait(0.2)
        prompt = getNearestPrompt(position)
    end

    return true
end

-- รีเซ็ต WalkSpeed เมื่อตัวเกิดใหม่
player.CharacterAdded:Connect(function(char)
    local hum = char:WaitForChild("Humanoid", 5)
    if hum then applyWalkSpeed(hum) end
end)

